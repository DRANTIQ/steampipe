# =============================================================================
# Cloud Compliance Engine — Sample environment
# Copy to .env and fill in. See user_input.md for details.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres 15+)
# -----------------------------------------------------------------------------
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=steampipe
# POSTGRES_USER=steampipe
# POSTGRES_PASSWORD=steampipe

# Or set a full URL instead of individual vars:
# DATABASE_URL=postgresql://steampipe:steampipe@localhost:5432/steampipe
DATABASE_URL=

# -----------------------------------------------------------------------------
# S3 / Object storage (evidence snapshots)
# -----------------------------------------------------------------------------
# Snapshots are written by the execution platform. Compliance engine reads from
# the same bucket/path. Path pattern (see src/services/snapshot.py):
#
#   S3:    s3://{S3_BUCKET}/tenant_id={tid}/provider={provider}/account_id={aid}/year={YYYY}/month={MM}/day={DD}/execution_id={execution_id}/result.json
#   Local: {LOCAL_STORAGE_PATH}/tenant_id={tid}/provider=.../execution_id={id}/result.json
#
# -----------------------------------------------------------------------------
# Local filesystem only (no S3):
# USE_LOCAL_STORAGE=true
# LOCAL_STORAGE_PATH=./local/snapshots

# Or S3 (set USE_LOCAL_STORAGE=false):
# USE_LOCAL_STORAGE=false
S3_BUCKET=steampipe-data-storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# USE_LOCAL_STORAGE=false
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=compliance
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# Redis (job-completion queue, optional in v1)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

REDIS_URL=

COMPLIANCE_QUEUE_KEY=compliance:job_completed

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Tenant used when X-Tenant-Id header not provided (dev only; UUID):
DEFAULT_TENANT_ID=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional: execution platform (if snapshots come from same system)
# -----------------------------------------------------------------------------
# Snapshots are just JSON from S3; the compliance engine only needs S3 (or local)
# and Postgres. If your snapshots are produced by another service (e.g. Steampipe
# execution platform), you can point to the same DB to read execution_jobs /
# execution_results for context (e.g. tenant_id, query_id). Not required if you
# only have S3 paths and metadata from elsewhere.
