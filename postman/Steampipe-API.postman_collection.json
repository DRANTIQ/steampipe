    {
      "name": "Tenants",
      "item": [
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "description": "Expected response format"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/tenants?skip=0&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "tenants"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "active",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Lists tenants. On success, saves first tenant id to environment variable `tenantId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const tenants = pm.response.json();",
                  "if (Array.isArray(tenants) && tenants.length > 0) {",
                  "    pm.environment.set('tenantId', tenants[0].id);",
                  "    console.log('tenantId \u2192', tenants[0].id);",
                  "}"
                ]
              }
            }
          ],
          "response": [],
          "auth": {
            "type": "inherit"
          }
        },
        {
          "name": "Get Tenant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "description": "Expected response format"
